# Mimori — environment variables.
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed; this example holds placeholders only.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# PostgreSQL (Prisma 7 reads this in prisma7.config.ts)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/mimori"

# ---------------------------------------------------------------------------
# Cloudinary — signed server-side uploads. Server-only; never expose these.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# Web Push (VAPID) — native notifications on the other subscribed devices.
# Generate one key pair for the whole app and use it everywhere; changing it
# invalidates every existing device subscription. See
# docs/PUSH_NOTIFICATIONS.md for how to generate and deploy these.
#
# NEXT_PUBLIC_... is sent to the browser and is public by design.
# VAPID_PRIVATE_KEY is server-only and must never reach the client.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
